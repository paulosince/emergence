    "experiment:phase1:csv": "node experiments/phase1-inputs.js --csv",
    "experiment:phase1:trace": "node experiments/phase1-inputs.js --trace-csv",
    "experiment:phase1:tempo": "node experiments/phase1-inputs.js --tempo-control",
    "experiment:world1d": "node experiments/world-1d-baseline.js",
    "experiment:world1d:json": "node experiments/world-1d-baseline.js --json",
    "experiment:world1d:csv": "node experiments/world-1d-baseline.js --csv",
    "experiment:world1d:events": "node experiments/world-1d-baseline.js --events-csv",
    "experiment:world-senses": "node experiments/world-senses.js",
    "experiment:world-senses:json": "node experiments/world-senses.js --json",
    "experiment:world-senses:csv": "node experiments/world-senses.js --csv",
    "experiment:world-senses:trace": "node experiments/world-senses.js --trace-csv",
    "experiment:world-senses:optical": "node experiments/world-senses.js --optical-only",
